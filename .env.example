# ─────────────────────────────────────────────────────────────
# Prompt Professor - Docker Environment Template
# Copy this file to `.env` and adjust values as needed.
# ─────────────────────────────────────────────────────────────

# App Ports (host)
FRONTEND_PORT=8080
BACKEND_PORT=5000

# Database
# Default is SQLite inside the backend container volume.
# For external Postgres replace with e.g.:
# DATABASE_URL=postgresql://user:password@db:5432/promptprof?schema=public
DATABASE_URL=file:/app/prisma/data/dev.db

# AI providers (at least one key recommended for optimizer features)
GEMINI_API_KEY=
GEMINI_MODEL=gemma-3-27b-it
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Public URLs used by backend for CORS + upload links
CORS_ORIGIN=http://localhost:8080
BASE_URL=http://localhost:8080

# Optional Cloudflare Tunnel
# Enable with: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
